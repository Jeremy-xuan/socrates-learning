{
  "version": 2,
  "name": "socrates-learning",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "OPENCLAW_MODEL": "bailian/qwen3.5-plus",
    "OPENCLAW_WORKSPACE": "./teacher"
  },
  "github": {
    "enabled": true,
    "silent": false,
    "autoJobCancelation": true
  }
}
