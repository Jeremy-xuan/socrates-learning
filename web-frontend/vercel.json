{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["sin1"],
  "env": {
    "GITHUB_OWNER": "Jeremy-xuan",
    "GITHUB_REPO": "socrates-learning",
    "GITHUB_BRANCH": "main",
    "OPENCLAW_MODEL": "bailian/qwen3.5-plus",
    "OPENCLAW_WORKSPACE": "./teacher",
    "OPENCLAW_GATEWAY_URL": "http://host.docker.internal:3001",
    "OPENCLAW_WORKSPACE_ROOT": "/root/.openclaw/workspace-gongbu",
    "SKIP_WECHAT_SYNC": "false",
    "NEXT_PUBLIC_OPENCLAW_API_URL": "/api/openclaw"
  },
  "github": {
    "silent": false,
    "autoJobCancelation": true
  }
}
