# 苏格拉底 AI 家教系统 — 环境变量配置

# GitHub 配置（用于文件同步）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=Jeremy-xuan
GITHUB_REPO=socrates-learning
GITHUB_BRANCH=main

# OpenClaw 配置
OPENCLAW_MODEL=bailian/qwen3.5-plus
OPENCLAW_WORKSPACE=./teacher

# 百炼 API（如直接使用）
BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Vercel 部署（生产环境变量，在 Vercel 控制台设置）
# NEXT_PUBLIC_VERCEL_ENV=production
# NEXT_PUBLIC_VERCEL_URL=your-app.vercel.app

# 可选：Token 预算预警（美元）
TOKEN_BUDGET_LIMIT=50

# 可选：会话超时时间（秒）
SESSION_TIMEOUT=3600
