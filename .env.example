# OpenClaw Environment Configuration
# Copy this file to .env.local and fill in your values

# Model Configuration
OPENCLAW_MODEL=bailian/qwen3.5-plus

# Workspace Directory (relative to project root)
OPENCLAW_WORKSPACE=./teacher

# Optional: API Keys for external services
# BAILIAN_API_KEY=your_bailian_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# PDF Conversion (optional, for on-the-fly PDF reading)
# PDF_CONVERTER=marker  # or 'pymupdf' for lightweight conversion

# Deployment Region (Vercel)
# VERCEL_REGION=dev1  # dev1 = US East, icn1 = Seoul, sin1 = Singapore
